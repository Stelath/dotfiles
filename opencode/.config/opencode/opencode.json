{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git remote": "allow",
      "git branch": "allow",
      "git ls-files": "allow",
      "rm *": "deny",
      "sudo *": "deny"
    },
    "external_directory": {
      "*": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.codex/**": "deny",
      "~/.opencode/**": "deny"
    },
    "webfetch": "ask",
    "websearch": "ask"
  },
  "experimental": {
    "openTelemetry": false
  }
}
